# Long random secret. The app sends it with every request. Generate one with:  openssl rand -hex 32
API_TOKEN=change-me

# Port the API listens on (direct HTTP access, e.g. http://164.68.97.148:7070).
# Once HTTPS works, use 127.0.0.1:7070 so the API is only reachable through HTTPS
# (Docker publishes ports past ufw, so closing the port in ufw alone is not enough).
API_PORT=7070

# Ports for Caddy (only with the https profile). The app then uses https://DOMAIN:773
HTTP_PORT=70
HTTPS_PORT=773

# Timezone used for "today" in the plan
TZ_NAME=Africa/Dar_es_Salaam

# Only for the https profile: a domain whose DNS A record points at this server
DOMAIN=plan.example.com
